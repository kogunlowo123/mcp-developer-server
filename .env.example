# mcp-devserver configuration.
#
# Copy to `.env` and edit. Every value below is the default, so an empty file
# behaves identically to this one.
#
# Names are `MCP_` + section + `__` + field. Unknown keys are REJECTED at
# start-up rather than ignored: a mistyped `MCP_SANDBOX__MAX_FILE_BTYES` would
# otherwise leave you believing a limit is in force that is not.
#
# `mcp-devserver doctor` prints what this configuration would actually serve.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# local | staging | production. In production a process that breaks any of the
# invariants listed under "Production invariants" below refuses to start.
MCP_ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Sandbox — the security boundary
# ---------------------------------------------------------------------------
# The one directory this server can reach. Everything outside it is
# unreachable, and this is the whole of the access-control configuration.
# Defaults to the working directory, which is convenient locally and wrong
# almost everywhere else; set it explicitly.
MCP_SANDBOX__WORKSPACE=/absolute/path/to/your/repository

# Off. A symbolic link is an indirection the caller did not ask for, and one
# that leaves the workspace is refused by containment regardless. Turning this
# on is refused in production.
MCP_SANDBOX__FOLLOW_SYMLINKS=false

# Names or globs added to the built-in denylist (.env, *.pem, id_rsa, .git/,
# .ssh/, ...). Comma-separated. The list can only grow: there is no setting
# that removes a built-in entry.
MCP_SANDBOX__DENY_EXTRA=

# Bounds. Each exists because an unbounded version of it is a way to make the
# developer's own machine unusable.
MCP_SANDBOX__MAX_FILE_BYTES=1048576
MCP_SANDBOX__MAX_READ_LINES=4000
MCP_SANDBOX__MAX_SEARCH_RESULTS=200
MCP_SANDBOX__MAX_SEARCH_FILES=20000
MCP_SANDBOX__MAX_RESULT_BYTES=262144
MCP_SANDBOX__MAX_DIRECTORY_ENTRIES=1000
MCP_SANDBOX__MAX_GIT_ENTRIES=200
MCP_SANDBOX__TOOL_TIMEOUT_SECONDS=15.0

# ---------------------------------------------------------------------------
# Security — controls on everything leaving the process
# ---------------------------------------------------------------------------
# Replace recognised credentials in tool output. Off means a hard-coded key in
# a source file is returned verbatim to a language model. Refused in production.
MCP_SECURITY__REDACT_SECRETS=true

# Score returned content for instruction-like text and report what was found.
# Off means file contents arrive with no indication that they are untrusted.
# Refused in production.
MCP_SECURITY__SCAN_UNTRUSTED_CONTENT=true

# Include the matched excerpt in the assessment. Useful for a human reviewing
# what fired; consider turning it off where results are archived, since the
# excerpt duplicates file content into that archive.
MCP_SECURITY__INCLUDE_SIGNAL_EXCERPTS=true

# ---------------------------------------------------------------------------
# Server identity
# ---------------------------------------------------------------------------
MCP_SERVER__NAME=mcp-devserver
MCP_SERVER__TITLE=MCP Developer Server

# How long a client may cache server/discover and tools/list, in milliseconds.
# The tool set is fixed at start-up, so an hour is honest.
MCP_SERVER__DISCOVERY_TTL_MS=3600000

# Sent to clients in server/discover. Leave the default unless you know what
# your client does with it; it is where the meaning of the <untrusted-...>
# fences is explained.
# MCP_SERVER__INSTRUCTIONS=

# ---------------------------------------------------------------------------
# HTTP transport — only used with `serve --transport http`
# ---------------------------------------------------------------------------
# Loopback by default. In a container this must be 0.0.0.0 or the published
# port reaches nothing; the image sets that for you.
MCP_HTTP__HOST=127.0.0.1
MCP_HTTP__PORT=8080

# Required in the `Authorization: Bearer` header when set. Empty means the
# endpoint accepts any caller, which for a local listener means any process on
# the machine and any page the developer visits. Production refuses to start
# without one. REPLACE_ME with a value from a real secret store.
MCP_HTTP__BEARER_TOKEN=

# Browser origins allowed to reach the endpoint, comma-separated. Empty means
# none, which is right for a server an editor talks to over loopback. A request
# with no Origin header did not come from a browser and is allowed.
MCP_HTTP__ALLOWED_ORIGINS=

MCP_HTTP__MAX_REQUEST_BYTES=1048576

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# debug | info | warning | error
MCP_OBSERVABILITY__LOG_LEVEL=info

# JSON on stderr. Never stdout: on the stdio transport stdout is the wire, and
# a log line written there corrupts the protocol stream.
MCP_OBSERVABILITY__LOG_JSON=true

# Record the arguments of each tool call. Off by default: paths are not secrets,
# but they are the developer's private directory structure, and a log file
# attached to a bug report should not carry it.
MCP_OBSERVABILITY__LOG_TOOL_ARGUMENTS=false

# OpenTelemetry. Requires the `otel` extra.
MCP_OBSERVABILITY__TRACING_ENABLED=false
MCP_OBSERVABILITY__OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Production invariants
# ---------------------------------------------------------------------------
# With MCP_ENVIRONMENT=production, the process refuses to start if:
#
#   - MCP_SECURITY__REDACT_SECRETS is false
#   - MCP_SECURITY__SCAN_UNTRUSTED_CONTENT is false
#   - MCP_SANDBOX__FOLLOW_SYMLINKS is true
#   - MCP_HTTP__BEARER_TOKEN is empty
#   - MCP_SANDBOX__WORKSPACE is a home directory or a filesystem root
#
# The bearer-token rule applies even when serving over stdio, where no port is
# opened. That is deliberate — see docs/configuration.md — and the way to run a
# hardened stdio server is MCP_ENVIRONMENT=local with the other invariants
# satisfied, which `doctor` will confirm.
